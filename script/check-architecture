#!/usr/bin/env bash
# Enforce the two rules AGENTS.md §1 makes load-bearing, plus the fallibility
# rule from §3.6. Written as a script rather than inline YAML so it can be run
# locally and gives a readable failure.
#
#   script/check-architecture
set -euo pipefail

cd "$(dirname "$0")/.."

status=0

fail() {
  echo "::error::$1"
  status=1
}

# --- rule 1: the data layer must never import GPUI -------------------------
# This is the split that makes `cargo test` meaningful on a machine with no
# display. A single `use gpui_kit::...` under src/collect/ or in model.rs
# breaks it, and the consequence is not a compile error but a test suite that
# can no longer run headless.
if hits="$(grep -rn 'gpui' src/collect/ src/model.rs || true)"; [ -n "$hits" ]; then
  fail "the data layer must not know about GPUI (AGENTS.md §1):"
  printf '%s\n' "$hits"
fi

# --- rule 2: no unwrap/expect on a fallible path ---------------------------
# Every read of /proc or /sys is fallible: a missing file, a vanished pid, a
# permission error. A panic on the UI thread kills the window, so these degrade
# to None instead.
#
# `awk` drops everything from the first `#[cfg(test)]` to the end of the file,
# which is exactly the region where unwrap is fine — tests assert, and a failed
# assert should panic.
#
# The single allowed exception is main.rs's `open_window(..).expect(..)`: if the
# window cannot open there is nothing left to run, so AGENTS.md §3.6 sanctions
# it.
offenders="$(for f in $(find src -name '*.rs' ! -name main.rs); do
  awk -v file="$f" '
    /#\[cfg\(test\)\]/ { in_test = 1 }
    !in_test && (/\.unwrap\(\)/ || /\.expect\(/) { print file ":" FNR ":" $0 }
  ' "$f"
done || true)"

if [ -n "$offenders" ]; then
  fail "unwrap/expect outside #[cfg(test)] (AGENTS.md §3.6):"
  printf '%s\n' "$offenders"
fi

# main.rs is checked separately because it owns the one sanctioned expect. The
# `open_window(..)` call and its `.expect(..)` sit at opposite ends of a
# multi-line method chain, so matching on line numbers would be brittle. Match
# on the expect's own message instead, which names the one permitted failure.
main_bad="$(grep -n '\.unwrap()\|\.expect(' src/main.rs |
  grep -v 'failed to open the btop-gpui window' || true)"
main_total="$(grep -c '\.unwrap()\|\.expect(' src/main.rs || true)"
if [ -n "$main_bad" ] || [ "$main_total" -ne 1 ]; then
  fail "unwrap/expect in main.rs beyond the one sanctioned open_window (AGENTS.md §3.6):"
  printf '%s\n' "$main_bad"
  echo "  (found $main_total total in main.rs, expected exactly 1)"
fi

if [ "$status" -eq 0 ]; then
  echo "Architecture invariants hold."
fi

exit "$status"
